# Private: passphrase, derived key, and plaintext trip/food data never go to GitHub.
.secrets/
trip/*.json
guide/*.json
food/*.json
food/raw/
food/ai/
updater/state/
updater/out/
app/test/out/
node_modules/
.DS_Store
research/
app/dist/
app/test/fixtures/
# Dev and test material that names the real flights or dates stays on the Mac.
.claude/
app/test/
app/CONTRACT.md
updater/sample_status.json
updater/test_*.py
# Python bytecode from running the updater locally.
__pycache__/

# Airport walking-navigation data and raw OpenStreetMap pulls (sealed into guide.bin).
guide/nav/
guide/osm/
# Indoor airport maps and their raw venue data (third-party, sealed into data/indoor_<code>.bin).
guide/indoor/
# Local preview of the airport maps (plaintext guide data; tools/maps_build.py writes it).
guide/maps_preview.html

# Researched menu prices and visit style per place (merged into food.json, sealed).
food/prices/
